@*
    A titled page section: numbered rule, heading, optional kicker.
    Owns nothing but layout, every section on the site is one of these.
*@

<section id="@Id" class="section @(Tint ? "section--tint" : null) @Class" aria-labelledby="@($"{Id}-title")">
    <div class="shell">

        <header class="section__head reveal">
            <span class="section__index" aria-hidden="true">@Index</span>
            <div class="section__titles">
                <h2 class="section__title" id="@($"{Id}-title")">@Title</h2>
                @if (!string.IsNullOrWhiteSpace(Kicker))
                {
                    <p class="section__kicker">@Kicker</p>
                }
            </div>
            @Aside
        </header>

        @ChildContent
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter, EditorRequired] public string Index { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Kicker { get; set; }
    [Parameter] public bool Tint { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Aside { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
