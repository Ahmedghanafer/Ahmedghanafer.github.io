@*
    Inline SVG icon set. Small and hand-picked rather than a font or a package —
    four kilobytes of markup beats a webfont request for nine glyphs.
*@

<svg class="@Class" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@Stroke" stroke-linecap="round" stroke-linejoin="round"
     width="@Size" height="@Size" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "mail":
            <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
            <path d="m3.5 6.5 8.5 6 8.5-6" />
            break;

        case "github":
            <path d="M9 19c-4.3 1.3-4.3-2.2-6-2.6m12 4.6v-3.5a3 3 0 0 0-.9-2.4c2.9-.3 6-1.4 6-6.4a4.7 4.7 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.3s-1.1-.3-3.6 1.4a12.3 12.3 0 0 0-6.4 0C6.2 2 5.1 2.2 5.1 2.2a4.3 4.3 0 0 0-.1 3.3A4.7 4.7 0 0 0 3.7 8.8c0 5 3 6.1 5.9 6.4a3 3 0 0 0-.9 2.3V21" />
            break;

        case "linkedin":
            <path d="M4.5 9v11M4.5 5.2v.02" />
            <path d="M10 20V9m0 3.8c0-2 1.4-3.8 3.6-3.8S17 10.6 17 13v7" />
            break;

        case "arrow-up-right":
            <path d="M8 16 16 8M9.5 8H16v6.5" />
            break;

        case "arrow-right":
            <path d="M4 12h15m-6-6 6 6-6 6" />
            break;

        case "cloud":
            <path d="M6.5 18a4 4 0 0 1-.3-8 5.5 5.5 0 0 1 10.6-.9A3.8 3.8 0 0 1 17.5 18Z" />
            break;

        case "bolt":
            <path d="M13.5 2.5 4 13.5h6.5L10 21.5 20 10.5h-6.5Z" />
            break;

        case "database":
            <ellipse cx="12" cy="5.5" rx="7.5" ry="3" />
            <path d="M4.5 5.5v13c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-13M4.5 12c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3" />
            break;

        case "cog":
            <circle cx="12" cy="12" r="3.2" />
            <path d="M12 2.5v2.2M12 19.3v2.2M21.5 12h-2.2M4.7 12H2.5M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6M18.7 18.7l-1.6-1.6M6.9 6.9 5.3 5.3" />
            break;

        case "layers":
            <path d="m12 2.8 9 4.7-9 4.7-9-4.7Z" />
            <path d="m3 12.4 9 4.7 9-4.7M3 16.9l9 4.7 9-4.7" />
            break;

        case "server":
            <rect x="2.8" y="3.5" width="18.4" height="7" rx="2" />
            <rect x="2.8" y="13.5" width="18.4" height="7" rx="2" />
            <path d="M6.5 7h.02M6.5 17h.02" />
            break;

        case "monitor":
            <rect x="2.5" y="3.5" width="19" height="13" rx="2" />
            <path d="M8.5 20.5h7M12 16.5v4" />
            break;

        default:
            <circle cx="12" cy="12" r="8" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string Size { get; set; } = "20";
    [Parameter] public string Stroke { get; set; } = "1.6";
    [Parameter] public string? Class { get; set; }
}
